  "orientation": "any",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-48.png", "sizes": "48x48", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "store-assets/screenshot-1-rolls.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Food cost and profit on a batch of cinnamon rolls" },
    { "src": "store-assets/screenshot-2-lunch.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "A menu price that hits a 30 percent food cost" }
