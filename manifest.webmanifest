{
  "id": "./",
  "name": "Batchbook: Recipe Cost Calculator",
  "short_name": "Batchbook",
  "description": "Price a recipe from the package you bought, then set a menu price from your food-cost target. Pay once, no subscription.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#F6F1E8",
